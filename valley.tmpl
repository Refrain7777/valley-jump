WIDTH=1024  # {{cookiecutter.width}}
HEIGHT=600  # {{cookiecutter.height}}
REFX = 1980
REFY = 1080

def u(real, ref, v):
    if abs(v)<0.9999999:
        result = int( (float(real)/100.0) * (v*1000))
        if v<0:
            return real-result
        return result
    return int( (real/ref) * v )

def ux(*argv):
    global WIDTH, REFX
    acc = 0
    for v in argv:
        acc += u(WIDTH, REFX, v)
    return acc

def uy(*argv):
    global HEIGHT, REFY
    acc = 0
    for v in argv:
        acc += u(HEIGHT, REFY, v)
    return acc


async def custom_site():
    import sys
    import asyncio
    import platform
    import json
    from pathlib import Path
    import embed
    import pygame

    def html_progress(pct, text=""):
        try:
            platform.window._valleyProgress(float(pct), str(text or ""))
        except Exception:
            pass

    def compose():
        pygame.display.update()
        window.chromakey(None, *screen.get_colorkey(), 40)

    platform.document.body.style.background = "#1a1410"
    html_progress(8, "引擎启动中…")

    pygame.init()
    pygame.font.init()

    screen = pygame.display.set_mode([ux(.100),uy(.100)], pygame.SRCALPHA, 32)
    screen.set_colorkey( (0,0,0,0), pygame.RLEACCEL )
    screen.fill( (0,0,0,0) )
    compose()

    # 保留 HTML 加载层；默认模板会过早隐藏 transfer
    try:
        platform.window.transfer.hidden = true
    except Exception:
        pass
    platform.window.canvas.style.visibility = "visible"

    apk = "{{cookiecutter.archive}}.apk"
    bundle = "{{cookiecutter.archive}}"
    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    cfg = {
        "io": "url",
        "type":"mount",
        "mount" : {
            "point" : appdir.as_posix(),
            "path" : "/",
        },
        "path" : f"/ => {appdir.as_posix()}",
    }

    track = platform.window.MM.prepare(apk, json.dumps(cfg))
    html_progress(18, "下载游戏资源…")

    marginx = ux(.020)
    marginy = uy(.045)

    def pg_bar(pos):
        nonlocal marginx, marginy
        total = track.len or 10
        slot = ux(.060)/ total
        pygame.draw.rect(screen,(10,10,10),( marginx-ux(10), marginy-uy(10), (total*slot)+ux(20), uy(110) ) )
        pygame.draw.rect(screen,(240,196,64), ( marginx, marginy, track.pos*slot, uy(90)) )
        if track.len:
            pct = 18 + min(62, int(70 * (track.pos / max(1, track.len))))
            html_progress(pct, "下载游戏资源…")

    while not track.ready:
        pg_bar(track.pos)
        compose()
        await asyncio.sleep(.05)

    pg_bar(track.len)
    compose()
    html_progress(82, "解压资源…")

    platform.run_main(PyConfig, loaderhome= appdir / "assets", loadermain=None)

    while embed.counter()<0:
        html_progress(88, "编译模块…")
        await asyncio.sleep(.05)

    main = appdir / "assets" / "main.py"
    await TopLevel_async_handler.start_toplevel(platform.shell, console=window.python.config.debug)
    __import__(__name__).__file__ = str(main)

    fnt = pygame.sysfont.SysFont("freesans",  uy(80) )

    def ui_callback(pkg, error=None):
        nonlocal fnt
        if error:
            prompt = fnt.render(f"{error}", True, "black")
            html_progress(95, str(error))
        else:
            prompt = fnt.render(f"Setting [{pkg}] up", True, "black")
            html_progress(92, f"准备 {pkg}…")
        pg_bar(track.len)
        screen.blit(prompt, ( marginx+ ux(80), marginy - uy(10) ) )
        compose()

    if not platform.window.MM.UME:
        html_progress(96, "点一下屏幕开始")
        fnt = pygame.sysfont.SysFont("freesans",  uy(80) )
        prompt = fnt.render("Ready to start !", True, "blue")
        pg_bar(track.len)
        screen.blit(prompt, ( marginx+ ux(80), marginy - uy(10) ) )
        compose()
        while not platform.window.MM.UME:
            await asyncio.sleep(.1)

    html_progress(98, "启动游戏…")
    screen.fill( (0,0,0,0) )
    pygame.display.flip()
    await shell.runpy(main, callback=ui_callback)


import asyncio
asyncio.run( custom_site() )





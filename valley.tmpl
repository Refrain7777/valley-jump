    <script type="application/javascript">
    (function () {
        var fill = document.getElementById("valley-fill");
        var pctEl = document.getElementById("valley-pct");
        var msgEl = document.getElementById("valley-msg");
        var root = document.getElementById("valley-load");
        var last = 0;

        window._valleyProgress = function (pct, text) {
            pct = Math.max(0, Math.min(100, Number(pct) || 0));
            if (pct < last && pct < 99) pct = last;
            last = pct;
            if (fill) fill.style.width = pct + "%";
            if (pctEl) pctEl.textContent = Math.round(pct) + "%";
            if (text && msgEl) msgEl.textContent = text;
        };

        window._valleyHideLoader = function () {
            window._valleyProgress(100, "完成");
            if (!root) return;
            root.classList.add("hidden");
            setTimeout(function () {
                if (root && root.parentNode) root.parentNode.removeChild(root);
            }, 500);
        };

        // 跟 Emscripten 自带 #progress 同步（WASM / 引擎下载阶段）
        var prog = document.getElementById("progress");
        var status = document.getElementById("status");
        function syncNative() {
            if (!prog) return;
            var max = Number(prog.max) || 100;
            var val = Number(prog.value) || 0;
            if (max > 0 && val > 0) {
                var mapped = Math.min(16, (val / max) * 16);
                var text = (status && status.textContent) ? status.textContent : "下载引擎…";
                if (/download/i.test(text) || text === "Downloading...") text = "下载引擎…";
                window._valleyProgress(mapped, text);
            }
        }
        if (prog && typeof MutationObserver !== "undefined") {
            new MutationObserver(syncNative).observe(prog, { attributes: true, attributeFilter: ["value", "max"] });
        }
        setInterval(syncNative, 120);
        window._valleyProgress(2, "连接服务器…");
    })();

